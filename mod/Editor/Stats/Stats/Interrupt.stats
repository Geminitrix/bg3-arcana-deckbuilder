        <field name="Name" type="NameTableFieldDefinition" value="Interrupt_Arcana_Reaction_InstinctiveCharm" />
        <field name="DisplayName" type="TranslatedStringTableFieldDefinition" handle="h33656580ga9ccgf16egfec9g23d4a4e81d7c" version="1" />
