<?xml version="1.0" encoding="UTF-8"?>
<!-- Adds ArcanaSpellSlot to the game's SpellSlotsGroup, keeping the three vanilla members.

     This overrides a base game registry, which is normally worth avoiding, but there is no way
     around it. The whole game defines exactly one action resource group, and the rule that a slot
     of level N or higher pays for a spell of level N is a special case the engine ties to THIS
     group. A group of our own is inert: cards then demand a slot of their exact level, which is
     not how Warlock slots behave and not what the class wants.

     Sharing the group costs nothing here, because what marks a spell as one of the class's cards
     is its ArcanaHandCard cost, not which slot pays for it.

     Members below, in order: SpellSlot, WarlockSpellSlot, ShadowSpellSlot, ArcanaSpellSlot. -->
<save>
    <version major="4" minor="8" revision="0" build="500"/>
    <region id="ActionResourceGroupDefinitions">
        <node id="root">
            <children>
                <node id="ActionResourceGroupDefinition">
                    <attribute id="ActionResourceDefinitions" type="LSString" value="d136c5d9-0ff0-43da-acce-a74a07f8d6bf;e9127b70-22b7-42a1-b172-d02f828f260a;77fcde9b-9cda-4fbc-8806-393e26b2f3e1;25d3f3a7-f097-4e33-813c-54a1ef79ba8e"/>
                    <attribute id="Name" type="LSString" value="SpellSlotsGroup"/>
                    <attribute id="UUID" type="guid" value="03b17647-161a-42e1-9660-5ba517e80ad2"/>
                </node>
            </children>
        </node>
    </region>
</save>
