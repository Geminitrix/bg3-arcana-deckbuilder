<save>
    <version major="4" minor="8" revision="0" build="500"/>
    <region id="ActionResourceGroupDefinitions">
        <node id="root">
            <children>
                <!-- Nenhuma magia do jogo base cobra um recurso de espaco direto: os 2288 custos
                     passam por um grupo. Este e o equivalente do SpellSlotsGroup para a Arcana, com
                     o ArcanaSpellSlot sozinho dentro. Nao mexemos no grupo do vanilla: ele e
                     compartilhado e nao saberia distinguir uma carta da Arcana de uma magia de
                     multiclasse. -->
                <node id="ActionResourceGroupDefinition">
                    <attribute id="ActionResourceDefinitions" type="LSString" value="25d3f3a7-f097-4e33-813c-54a1ef79ba8e"/>
                    <attribute id="Name" type="LSString" value="ArcanaSpellSlotsGroup"/>
                    <attribute id="UUID" type="guid" value="8c9de04f-9bbc-4be9-8cb2-120bfca07777"/>
                </node>
            </children>
        </node>
    </region>
</save>
